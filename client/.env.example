# Client environment (copy to .env.local for local dev)

# REST API base URL for axios.
# Leave EMPTY for the same-origin /api proxy (recommended — see next.config.mjs
# rewrites). The browser calls the app's own origin and Next.js forwards /api/*
# to the backend, keeping auth cookies first-party so SameSite=Strict works in
# production. Set to a full URL only to bypass the proxy and hit the API directly.
NEXT_PUBLIC_API_URL=

# Direct backend origin for the Socket.io connection (NOT proxied — websockets
# don't proxy reliably through Next/Vercel; the socket authenticates with the
# Bearer access token, so same-origin isn't required).
NEXT_PUBLIC_SOCKET_URL=http://localhost:5050

# Server-side proxy target for the /api/* rewrite (next.config.mjs).
# Dev default is http://localhost:5050; in production set this to the deployed
# backend origin (e.g. https://api.baaskhoj.com). This is NOT public.
API_PROXY_TARGET=http://localhost:5050
