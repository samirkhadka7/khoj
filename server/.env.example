# Server
PORT=5050
NODE_ENV=development

# CORS — comma-separated list of frontend origins allowed to call the API.
# Use this in production for prod + staging + preview deploys.
# Falls back to FRONTEND_URL (single-origin) for backwards compat.
ALLOWED_ORIGINS=http://localhost:3000

# Legacy single-origin var (still read if ALLOWED_ORIGINS isn't set)
FRONTEND_URL=http://localhost:3000

# MongoDB — use MongoDB Atlas connection string in production
MONGODB_URI=mongodb://127.0.0.1:27017/baskhoj

# JWT — generate with: openssl rand -hex 64
JWT_SECRET=change_me_to_a_long_random_string
# Access-token lifetime — SHORT (Feature 5) so a stolen access token is only
# useful briefly. Long-lived sessions are carried by the HttpOnly refresh cookie.
JWT_EXPIRES_IN=15m

# Refresh-token (HttpOnly cookie) lifetime in DAYS (Feature 5). Default 30.
REFRESH_TOKEN_EXPIRES_DAYS=30

# Application-level encryption key for REVERSIBLE secrets:
#   - TOTP/MFA shared secrets (Feature 1)
#   - Sensitive KYC fields (Feature 4)
# 32 bytes, hex-encoded. Generate with: openssl rand -hex 32
# In production this must come from a secrets manager / KMS, never a committed file.
ENCRYPTION_KEY=

# Cloudinary (image upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Sparrow SMS (Nepal) — Step 14
SPARROW_SMS_TOKEN=

# Payments — Step 14
ESEWA_MERCHANT_CODE=
KHALTI_SECRET_KEY=

# Disable rate limiting for tests (also auto-disabled when NODE_ENV=test)
# RATE_LIMIT_DISABLED=true
