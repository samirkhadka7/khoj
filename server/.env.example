# Server
PORT=5050
NODE_ENV=development

# CORS — comma-separated list of frontend origins allowed to call the API.
# Use this in production for prod + staging + preview deploys.
# Falls back to FRONTEND_URL (single-origin) for backwards compat.
ALLOWED_ORIGINS=http://localhost:3000

# Legacy single-origin var (still read if ALLOWED_ORIGINS isn't set)
FRONTEND_URL=http://localhost:3000

# MongoDB — use MongoDB Atlas connection string in production
MONGODB_URI=mongodb://127.0.0.1:27017/baskhoj

# JWT — generate with: openssl rand -hex 64
JWT_SECRET=change_me_to_a_long_random_string
# Access-token lifetime — SHORT (Feature 5) so a stolen access token is only
# useful briefly. Long-lived sessions are carried by the HttpOnly refresh cookie.
JWT_EXPIRES_IN=15m

# Refresh-token (HttpOnly cookie) lifetime in DAYS (Feature 5). Default 30.
REFRESH_TOKEN_EXPIRES_DAYS=30

# hCaptcha secret (Feature 2). Leave UNSET in dev — the code defaults to hCaptcha's
# always-pass TEST secret so the flow works with no account. In production set this
# to your real secret from the hCaptcha dashboard (and set NEXT_PUBLIC_HCAPTCHA_SITEKEY
# on the client to the matching real sitekey).
# HCAPTCHA_SECRET=

# Application-level encryption key for REVERSIBLE secrets:
#   - TOTP/MFA shared secrets (Feature 1)
#   - Sensitive KYC fields (Feature 4)
# 32 bytes, hex-encoded. Generate with: openssl rand -hex 32
# In production this must come from a secrets manager / KMS, never a committed file.
ENCRYPTION_KEY=

# Cloudinary (image upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Sparrow SMS (Nepal) — Step 14
SPARROW_SMS_TOKEN=

# Payments — Step 14
ESEWA_MERCHANT_CODE=
KHALTI_SECRET_KEY=

# Rate limiting is ON by default in EVERY environment (Feature 2/C). Uncomment to
# turn it off for a one-off local debugging session only — never in production.
# RATE_LIMIT_DISABLED=true

# Trust-proxy hops — number of reverse proxies in front of the app so req.ip is
# the REAL client IP (else all users share the proxy's IP and rate limiting is
# useless). Default: 1 in production, off in dev. Set to match the actual deploy
# chain (e.g. Render + the Next.js /api proxy). NEVER use 'true' (IP spoofing).
# TRUST_PROXY_HOPS=1
